{
  "extends": "@react-native/typescript-config",
  "compilerOptions": {
    "target": "esnext",
    "lib": ["dom", "esnext"],
    "allowJs": true,
    "jsx": "react-native",
    "plugins": [],
    "paths": {
      "@/*": ["./src/*", "./*"]
    },
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": false,
    "forceConsistentCasingInFileNames": true,
    "moduleResolution": "nodenext",
    "resolveJsonModule": true,
    "module": "NodeNext",
    "isolatedModules": true,
    "noEmit": true
  },
  "include": ["**/*.ts", "**/*.tsx", "**/*.tsx"],
  "exclude": ["**/node_modules", "**/Pods"]
}
